# ============================================================
# MYSS — переменные окружения
# Скопируйте в .env и заполните. .env НИКОГДА не коммитится.
# ============================================================

# PostgreSQL (на Render подставляется автоматически из render.yaml)
DATABASE_URL="postgresql://user:password@localhost:5432/myss?schema=public"

# Telegram Bot — выдаётся @BotFather. Используется для проверки initData.
TELEGRAM_BOT_TOKEN=""

# Публичный URL приложения (без слэша в конце)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# URL Mini App, который регистрируется в BotFather
TELEGRAM_WEBAPP_URL="http://localhost:3000"

# Секрет для доступа к админке (заголовок x-admin-secret)
ADMIN_SECRET=""

# Telegram ID администраторов через запятую — получают доступ к /admin
ADMIN_TELEGRAM_IDS=""

# Секрет для установки вебхука бота
TELEGRAM_WEBHOOK_SECRET=""

# Разрешить работу вне Telegram в dev-режиме (никогда не включать в production)
ALLOW_DEV_AUTH="false"
